{
  "name": "orion-ai-os",
  "version": "0.1.1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON -c blue,magenta \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:pack": "npm run build && electron-builder",
    "electron:publish": "npm run build && electron-builder --publish always",
    "postinstall": "node scripts/copy-onnx-wasm.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.7.5",
    "@clerk/ui": "^1.30.3",
    "@elevenlabs/elevenlabs-js": "^2.64.0",
    "@sentry/electron": "^7.16.0",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.1.0",
    "googleapis": "^174.0.1",
    "lucide-react": "^1.31.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "^1.27.0",
    "openai": "^7.4.0",
    "playwright": "^1.62.1",
    "posthog-js": "^1.417.1",
    "posthog-node": "^5.49.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.orion.ai-os",
    "productName": "ORION",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!**/.env",
      "!**/.env.*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!node_modules"
        ]
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      }
    ],
    "afterPack": "scripts/electron-after-pack.js",
    "publish": {
      "provider": "github",
      "owner": "abdirazaqbashir4-eng",
      "repo": "ORION"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
