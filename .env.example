# ============================================================
# ORION AI OS — environment configuration
# Copy to .env.local and fill in the integrations you're ready
# to enable. Every value is optional at boot — ORION detects
# which features are configured and reports status in the
# System Monitor (/system) — nothing crashes for missing keys
# except the specific feature that needs them.
# ============================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Authentication — Clerk (Phase 2) --------------------------------
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database — Supabase / Postgres (Phase 3) -------------------------
# https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- AI — Claude API (Phase 5) ----------------------------------------
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Voice — Whisper (STT) + ElevenLabs (TTS) (Phase 7) ---------------
OPENAI_API_KEY=
# https://elevenlabs.io -> Profile -> API Keys. Server-side only — never
# exposed to the browser or the Electron renderer (see src/lib/voice/tts).
ELEVENLABS_API_KEY=
# https://elevenlabs.io/app/voice-lab -> pick a voice -> copy its Voice ID.
ELEVENLABS_VOICE_ID=
# Optional — defaults to eleven_turbo_v2_5 if unset.
ELEVENLABS_MODEL=

# --- Email — Gmail (Phase 9) -------------------------------------------
# https://console.cloud.google.com -> OAuth 2.0 Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Browser automation (Phase 11) -------------------------------------
PLAYWRIGHT_HEADLESS=true

# --- Monitoring & analytics (Phase 12) ----------------------------------
# https://sentry.io -> your ORION project -> Settings -> Client Keys (DSN).
# A DSN is a public identifier by Sentry's own design (safe to ship to a
# browser/client), not a secret — this one value is reused across all
# three ORION surfaces: the Electron main process (electron/main.js),
# the Next.js server, and the browser/renderer (src/instrumentation.ts,
# instrumentation-client.ts). No separate per-surface DSN needed.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Meetings — Fireflies.ai (Phase 14) ---------------------------------
# https://app.fireflies.ai/settings -> Developer Settings -> API Key.
# Server-side only — never exposed to the browser or Electron renderer.
FIREFLIES_API_KEY=

# --- Marketing — Meta Marketing API (Phase 15) ---------------------------
# https://developers.facebook.com/apps -> your app -> Settings -> Basic.
# All four values are server-side only — never exposed to the browser or
# the Electron renderer (see src/lib/meta/client.ts).
META_APP_ID=
META_APP_SECRET=
META_CLIENT_TOKEN=
META_ACCESS_TOKEN=
# https://business.facebook.com -> Ad Account -> Settings, format act_XXXXXXXXXX.
META_AD_ACCOUNT_ID=
# Optional — defaults to v21.0 if unset.
META_API_VERSION=

# --- Wake word — openWakeWord (Phase 16) ----------------------------------
# No configuration needed — runs entirely on-device via ONNX Runtime Web,
# using the pretrained "Hey Jarvis" model bundled at
# public/wake-word/openwakeword/. No account, API key, or cloud service of
# any kind (this is why openWakeWord replaced Picovoice: Picovoice is a
# B2B-only platform that requires a company email to sign up).
# A custom-trained "Hey ORION" model is a planned follow-up — see
# src/lib/wake-word/openwakeword-engine.ts for how to swap the keyword
# model file once one exists.

# --- Voice — Azure Speech: Somali + Arabic STT/TTS (Phase 16) ------------
# https://portal.azure.com -> Speech service -> Keys and Endpoint.
# Server-side only — the renderer only ever receives a short-lived token
# minted by /api/voice/azure-token, never this key itself.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional — these already default to the values below if unset.
AZURE_SPEECH_VOICE_SOMALI=so-SO-MuuseNeural
AZURE_SPEECH_VOICE_ARABIC=ar-SA-HamedNeural

# --- Security -----------------------------------------------------------
# Random 32+ char secret used to encrypt stored integration tokens.
ENCRYPTION_SECRET=
# Shared secret required on Vercel Cron / automation-triggered routes.
CRON_SECRET=
